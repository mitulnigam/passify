# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────
/.next/
/out/
/build

# ── Testing ──────────────────────────────────
/coverage

# ── Environment variables ─────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ── Debug logs ───────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / Editor ──────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Vercel ───────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────
*.tsbuildinfo
next-env.d.ts
