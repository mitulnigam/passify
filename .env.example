# Passify Environment Configuration
# Copy this file to .env.local and populate the secrets. Never commit real credentials.

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Application URLs & CORS
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated exact additional origins, e.g. a specific preview deployment.
ALLOWED_ORIGINS=

# Session & Token Secret (HMAC-SHA256, at least 32 characters)
AUTH_SECRET=replace-with-a-random-32-character-secret
